DATABASE_URL=sqlite:///./apex_ai.db

# 登录安全：JWT 密钥（生产务必改成随机长串）
JWT_SECRET=请改成随机长字符串
JWT_EXPIRE_HOURS=168

# 邮箱验证码（推荐个人使用，QQ/163 授权码即可真收）
# QQ：SMTP_HOST=smtp.qq.com  SMTP_PORT=465  SMTP_SSL=true
# 用户名填完整邮箱；密码填「授权码」不是 QQ 登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Apex AI
# EMAIL_DEMO=true 时不真发、页面回显验证码
EMAIL_DEMO=false

# 阿里云短信（需企业资质；个人可忽略）
SMS_DEMO=true
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_TEMPLATE_PARAM_KEY=code
SMS_REGION_ID=cn-hangzhou

# 对话大模型：智谱（优先）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash
QIANWEN_READ_TIMEOUT=120

# 兼容旧配置（未填 ZHIPU_API_KEY 时才会用）
# QIANWEN_API_KEY=
# QIANWEN_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# QIANWEN_MODEL=glm-4-flash

# 图片：魔搭
MODELSCOPE_API_KEY=
MODELSCOPE_IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo

# 支付宝真实收款（VIP 在线充值）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=true
PUBLIC_BASE_URL=https://你的域名
# ALIPAY_PRIVATE_KEY_PATH=
# ALIPAY_PUBLIC_KEY_PATH=

# 视频：默认免费魔搭；true 才启用收费通义万相
VIDEO_ALLOW_PAID=false
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo
DASHSCOPE_VIDEO_MODEL=wanx2.1-t2v-turbo
# 真修图（照片修复）：通义万相图像编辑，需 sk- Key，按量计费
DASHSCOPE_IMAGE_EDIT_MODEL=wanx2.1-imageedit
